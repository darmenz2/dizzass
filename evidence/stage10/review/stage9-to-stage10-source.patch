+}
+static uint32_t chip(void *opaque,uint32_t nonce){reader_context *x=opaque;(void)nonce;x->chips++;return 2;}
+static uint32_t core(void *opaque,uint32_t nonce){reader_context *x=opaque;(void)nonce;x->cores++;return 7;}
