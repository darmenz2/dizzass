+name: Check original 1.3.5 synchronous temperature and shutdown
+on:
+  push:
+    branches: [work/reconstruction]
+    paths:
+      - src/backend/base.c
+      - src/backend/temp.c
+      - integration/*135.h
+      - integration/thermal-completion-135.mk
+      - integration/tests/test_thermal_reader_135.py
+      - integration/tests/test_backend_shutdown_135.py
+      - integration/tests/test_thermal_request_route_135.py
+      - integration/tests/test_thermal_completion_135.c
+      - integration/evidence/thermal_completion_135.json
+      - .github/workflows/thermal-completion-135.yml
+  workflow_dispatch:
+permissions:
+  contents: read
+concurrency:
+  group: thermal-completion135-${{ github.ref }}
+  cancel-in-progress: true
+jobs:
+  completion135:
+    if: github.repository == 'darmenz2/dizzass'
+    runs-on: ubuntu-22.04
+    timeout-minutes: 10
+    strategy:
+      matrix:
+        cc: [gcc, clang]
+    steps:
+      - name: Fetch exact source without persistent credentials
+        env:
+          GH_TOKEN: ${{ github.token }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          root="$RUNNER_TEMP/dizzass-completion135-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-${{ matrix.cc }}"
+          mkdir "$root"
+          cd "$root"
+          git init -q
+          git remote add origin "https://github.com/$GITHUB_REPOSITORY.git"
+          auth=$(printf 'x-access-token:%s' "$GH_TOKEN" | base64 -w0)
+          git -c "http.extraheader=AUTHORIZATION: basic $auth" fetch --depth=1 --no-tags origin "$GITHUB_SHA"
+          git checkout -q --detach FETCH_HEAD
+          test "$(git rev-parse HEAD)" = "$GITHUB_SHA"
+          printf 'SOURCE_ROOT=%s\n' "$root" >> "$GITHUB_ENV"
+      - name: Original reader shutdown and selected temperature methods
+        run: |
+          cd "$SOURCE_ROOT"
+          make -f integration/thermal-completion-135.mk CC=${{ matrix.cc }} dizzass-completion135-original dizzass-completion135-route dizzass-completion135-test
+      - name: Native state and bounded memory with sanitizers
+        run: |
+          cd "$SOURCE_ROOT"
+          make -f integration/thermal-completion-135.mk CC=${{ matrix.cc }} SANITIZE=1 dizzass-completion135-test
+      - name: Previous temperature and resume regression
+        run: |
+          cd "$SOURCE_ROOT"
+          make -f integration/thermal-sensors-135.mk CC=${{ matrix.cc }} dizzass-thermal135-original dizzass-thermal135-test dizzass-thermal135-airflow
+          make -f integration/thermal-routes-135.mk CC=${{ matrix.cc }} dizzass-routes135-original dizzass-routes135-test
+          make -f integration/backend-resume-135.mk CC=${{ matrix.cc }} dizzass-resume135-original dizzass-resume135-test
+      - name: Static analysis and unchanged production boundary
+        run: |
+          cd "$SOURCE_ROOT"
+          clang --analyze -I. -std=c11 -DVN135_THERMAL_READER_135 -DVN135_BACKEND_SHUTDOWN_135 -Xanalyzer -analyzer-output=text src/backend/base.c src/backend/temp.c
+          test "$(git hash-object Makefile.am)" = 17d2fbde26b5e8cb614b61908b84d5937af48325
+          test "$(git hash-object cgminer.c)" = 54739e4139294c526af0c73aa9a02ba9762ca4f2
+          printf '%s\n' 'b2663b3aa753cc14ae9d3b11a14d3d93c74b605a3e433b02101c3c17c69d95e9  reference/cgminer.vendor.elf' | sha256sum -c -
+          printf '%s\n' 'Offline bounded original behavior. No physical thread cancellation, temperature query stream, electrical-off proof or slot reuse acceptance.'
