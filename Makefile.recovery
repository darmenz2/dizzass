	VN135_TEST_LIBRARY=./build/libvn135_recovered-clang.so $(PYTHON) tests/test_stage10_differential.py pipeline
	$(CLANG) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer $(SOURCES) tests/test_work_difficulty.c -o build/test-work-difficulty-clang-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-work-difficulty-clang-sanitized
evidence-stage10:
	$(PYTHON) tools/check_stage10_evidence.py
test: stage10
sanitize: sanitize-stage10
evidence-check: evidence-stage10

# Stage11: owned text, zero-roll cloning, clear/delete and metadata slices.
.PHONY: stage11 stage11-clang sanitize-stage11 evidence-stage11
build/test-work-storage: $(SOURCES) tests/test_work_storage.c tests/fixtures/genesis_work.h $(HEADERS)
