# Standalone recovery targets; does not replace upstream cgminer's Makefile.am.
CC ?= cc
AR ?= ar
CLANG ?= clang
LLVM_AR ?= llvm-ar
PYTHON ?= python3
CPPFLAGS += -Iinclude
CFLAGS ?= -O2 -g
STRICT = -ffp-contract=off -std=c11 -Wall -Wextra -Wpedantic -Werror
SOURCES = reconstruction/support/work_freshness_snapshot.c reconstruction/support/record_fifo.c reconstruction/support/nonce_fifo.c reconstruction/support/nonce_record_bridge.c reconstruction/support/work_time_hex.c reconstruction/support/work_storage_pipeline.c reconstruction/support/work_difficulty_pipeline.c reconstruction/support/sha256_bytes.c reconstruction/support/work_rebuild_pipeline.c src/frontend/cgminer.c reconstruction/support/sha256d80.c reconstruction/support/target256.c reconstruction/support/nonce_job_window.c reconstruction/support/sha256_midstate.c reconstruction/support/work_nonce_pipeline.c src/backend/work-gen/work-gen.c reconstruction/support/work_rx_stream.c libbitmain/src/uart.c libbitmain/src/chip/chip1398.c libbitmain/src/pll.c libbitmain/src/aml/chip.c reconstruction/support/crc5.c libbitmain/src/reg_cache.c
HEADERS = include/xminer/recovery/work_freshness.h include/xminer/recovery/nonce_fifo.h include/xminer/recovery/work_time.h include/xminer/recovery/work_storage.h include/xminer/recovery/difficulty.h include/xminer/recovery/work_rebuild.h include/xminer/recovery/nonce_verify.h include/xminer/recovery/work_nonce.h include/xminer/recovery/sha256_midstate.h include/xminer/recovery/work_rx.h include/xminer/recovery/uart.h include/xminer/recovery/chip1398.h include/xminer/recovery/pll.h include/xminer/recovery/aml_chip.h include/xminer/recovery/reg_cache.h reconstruction/data/reg_cache_defaults.inc
OBJECTS = $(patsubst %.c,build/host/%.o,$(SOURCES))
ARM_OBJECTS = $(patsubst %.c,build/arm/%.o,$(SOURCES))
.PHONY: all test linux-pty arm sanitize sanitize-linux-pty evidence-check clean full-runtime
all: build/libvn135_recovered.a
build/host/%.o: %.c $(HEADERS)
	mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) $(STRICT) -c $< -o $@
build/libvn135_recovered.a: $(OBJECTS)
	$(AR) rcs $@ $^
build/libvn135_recovered.so: $(SOURCES) $(HEADERS)
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(STRICT) -shared -fPIC $(SOURCES) -o $@
build/test-chip1398: $(SOURCES) tests/test_chip1398.c $(HEADERS)
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(STRICT) $(SOURCES) tests/test_chip1398.c -o $@
build/test-pll-aml: $(SOURCES) tests/test_pll_aml.c $(HEADERS)
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(STRICT) $(SOURCES) tests/test_pll_aml.c -o $@
build/test-reg-cache: $(SOURCES) tests/test_reg_cache.c $(HEADERS)
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(STRICT) $(SOURCES) tests/test_reg_cache.c -o $@
build/test-uart: libbitmain/src/uart.c tests/test_uart.c include/xminer/recovery/uart.h
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(STRICT) libbitmain/src/uart.c tests/test_uart.c -o $@
build/test-uart-pty: libbitmain/src/uart.c libbitmain/src/aml/chip.c tests/test_uart_linux_pty.c $(HEADERS)
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(STRICT) libbitmain/src/uart.c libbitmain/src/aml/chip.c tests/test_uart_linux_pty.c -pthread -o $@
linux-pty: build/test-uart-pty
	./build/test-uart-pty
sanitize-linux-pty:
	mkdir -p build
	$(CC) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer libbitmain/src/uart.c libbitmain/src/aml/chip.c tests/test_uart_linux_pty.c -pthread -o build/test-uart-pty-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-uart-pty-sanitized
test: build/test-work-rx build/test-chip1398 build/test-pll-aml build/test-reg-cache build/test-uart build/libvn135_recovered.so
	./build/test-work-rx
	./build/test-chip1398
	./build/test-pll-aml
	./build/test-reg-cache
	./build/test-uart
	$(PYTHON) tests/test_arm_subset.py
	$(PYTHON) tests/test_arm_differential.py
	$(PYTHON) tests/test_stage3_interpreter.py
	$(PYTHON) tests/test_stage3_differential.py
	$(PYTHON) tests/test_stage4_cache_differential.py
	$(PYTHON) tests/test_stage4_config_differential.py
	$(PYTHON) tests/test_stage5_uart_differential.py
	$(PYTHON) tests/test_stage5_aml_uart_differential.py
	$(PYTHON) tools/check_stage5_evidence.py
	$(PYTHON) tools/check_stage6_evidence.py
	$(PYTHON) tools/check_stage7_evidence.py
	$(PYTHON) tests/test_stage6_interpreter.py
	$(PYTHON) tests/test_stage6_rx_differential.py
	$(PYTHON) tests/test_stage6_stream_differential.py
	$(PYTHON) tests/test_tree.py
arm: $(ARM_OBJECTS)
	$(LLVM_AR) rcs build/libvn135_recovered-armv7.a $(ARM_OBJECTS)
build/arm/%.o: %.c $(HEADERS)
	mkdir -p $(dir $@)
	$(CLANG) --target=armv7-none-eabihf -marm -march=armv7-a -mfpu=vfpv3-d16 -mfloat-abi=hard -ffreestanding $(CPPFLAGS) -O2 $(STRICT) -c $< -o $@
sanitize:
	mkdir -p build
	$(CC) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer $(SOURCES) tests/test_chip1398.c -o build/test-sanitized
	ASAN_OPTIONS=detect_leaks=0 ./build/test-sanitized
	$(CC) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer $(SOURCES) tests/test_pll_aml.c -o build/test-pll-aml-sanitized
	ASAN_OPTIONS=detect_leaks=0 ./build/test-pll-aml-sanitized
	$(CC) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer $(SOURCES) tests/test_reg_cache.c -o build/test-reg-cache-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-reg-cache-sanitized
	$(CC) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer libbitmain/src/uart.c tests/test_uart.c -o build/test-uart-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-uart-sanitized
evidence-check:
	$(PYTHON) tools/check_stage14_evidence.py
	$(PYTHON) tools/check_evidence.py
	$(PYTHON) tools/extract_reg_cache_defaults.py
	$(PYTHON) tools/check_stage5_evidence.py
	$(PYTHON) tools/check_stage6_evidence.py
	$(PYTHON) tools/check_stage7_evidence.py
full-runtime:
	@echo "NOT IMPLEMENTED: T21 runtime/model dispatch/live transport/PLL programming/PSU/autotune are incomplete." >&2
	@exit 2
clean:
	rm -rf build

.PHONY: fixtures
fixtures:
	$(CLANG) --target=armv7-none-eabihf -marm -march=armv7-a -mfpu=vfpv3-d16 -mfloat-abi=hard -c tests/arm32_instructions.S -o tests/fixtures/arm32_instructions.o
	$(CLANG) --target=armv7-none-eabihf -marm -march=armv7-a -mfpu=vfpv3-d16 -mfloat-abi=hard -c tests/arm32_stage3_instructions.S -o tests/fixtures/arm32_stage3_instructions.o

# Stage 6 RX code plus a separately identified bounded integration adapter.
build/test-work-rx: src/backend/work-gen/work-gen.c reconstruction/support/sha256_midstate.c reconstruction/support/work_rx_stream.c tests/test_work_rx.c include/xminer/recovery/work_rx.h
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(STRICT) src/backend/work-gen/work-gen.c reconstruction/support/sha256_midstate.c reconstruction/support/work_rx_stream.c tests/test_work_rx.c -o $@
.PHONY: sanitize-work-rx
sanitize: sanitize-work-rx
sanitize-work-rx:
	mkdir -p build
	$(CC) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer src/backend/work-gen/work-gen.c reconstruction/support/sha256_midstate.c reconstruction/support/work_rx_stream.c tests/test_work_rx.c -o build/test-work-rx-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-work-rx-sanitized
.PHONY: fixtures-stage6
fixtures-stage6:
	$(CLANG) --target=armv7-none-eabihf -marm -march=armv7-a -c tests/arm32_stage6_instructions.S -o tests/fixtures/arm32_stage6_instructions.o

.PHONY: linux-pty-rx sanitize-linux-pty-rx
build/test-work-rx-pty: libbitmain/src/uart.c src/backend/work-gen/work-gen.c reconstruction/support/sha256_midstate.c reconstruction/support/work_rx_stream.c tests/test_work_rx_linux_pty.c $(HEADERS)
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(STRICT) libbitmain/src/uart.c src/backend/work-gen/work-gen.c reconstruction/support/sha256_midstate.c reconstruction/support/work_rx_stream.c tests/test_work_rx_linux_pty.c -pthread -o $@
linux-pty-rx: build/test-work-rx-pty
	./build/test-work-rx-pty
sanitize-linux-pty-rx:
	mkdir -p build
	$(CC) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer libbitmain/src/uart.c src/backend/work-gen/work-gen.c reconstruction/support/sha256_midstate.c reconstruction/support/work_rx_stream.c tests/test_work_rx_linux_pty.c -pthread -o build/test-work-rx-pty-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-work-rx-pty-sanitized

# Stage 7: original nonce materialization; separately labeled pipeline adapter.
.PHONY: stage7 sanitize-stage7 fixtures-stage7
build/test-work-nonce: $(SOURCES) tests/test_work_nonce.c $(HEADERS)
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(STRICT) $(SOURCES) tests/test_work_nonce.c -o $@
stage7: build/libvn135_recovered.so build/test-work-nonce
	./build/test-work-nonce
	$(PYTHON) tests/test_stage7_interpreter.py
	$(PYTHON) tests/test_stage7_differential.py version
	$(PYTHON) tests/test_stage7_differential.py prepare
	$(PYTHON) tests/test_stage7_differential.py sha
	$(PYTHON) tests/test_stage7_differential.py core
test: stage7
sanitize: sanitize-stage7
sanitize-stage7:
	mkdir -p build
	$(CC) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer $(SOURCES) tests/test_work_nonce.c -o build/test-work-nonce-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-work-nonce-sanitized
fixtures-stage7:
	$(CLANG) --target=armv7-none-eabihf -marm -march=armv7-a -c tests/arm32_stage7_instructions.S -o tests/fixtures/arm32_stage7_instructions.o

.PHONY: stage7-clang
build/libvn135_recovered-clang.so: $(SOURCES) $(HEADERS)
	mkdir -p build
	$(CLANG) $(CPPFLAGS) $(CFLAGS) $(STRICT) -shared -fPIC $(SOURCES) -o $@
build/test-work-nonce-clang: $(SOURCES) $(HEADERS) tests/test_work_nonce.c
	mkdir -p build
	$(CLANG) $(CPPFLAGS) $(CFLAGS) $(STRICT) $(SOURCES) tests/test_work_nonce.c -o $@
stage7-clang: build/libvn135_recovered-clang.so build/test-work-nonce-clang
	./build/test-work-nonce-clang
	$(PYTHON) tests/test_stage7_differential.py version --library ./build/libvn135_recovered-clang.so --tag clang
	$(PYTHON) tests/test_stage7_differential.py prepare --library ./build/libvn135_recovered-clang.so --tag clang
	$(PYTHON) tests/test_stage7_differential.py sha --library ./build/libvn135_recovered-clang.so --tag clang
	$(PYTHON) tests/test_stage7_differential.py core --library ./build/libvn135_recovered-clang.so --tag clang
	$(CLANG) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer $(SOURCES) tests/test_work_nonce.c -o build/test-work-nonce-clang-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-work-nonce-clang-sanitized

# Stage 8: full header hash, target, bounded prefilter and recent-job selection.
.PHONY: stage8 stage8-clang sanitize-stage8 fixtures-stage8
build/test-nonce-verify: $(SOURCES) tests/test_nonce_verify.c $(HEADERS)
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(STRICT) $(SOURCES) tests/test_nonce_verify.c -o $@
build/vn135-verify-header: $(SOURCES) examples/verify_header.c $(HEADERS)
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(STRICT) $(SOURCES) examples/verify_header.c -o $@
fixtures-stage8:
	$(CLANG) --target=armv7-none-eabihf -marm -march=armv7-a -c tests/arm32_stage8_instructions.S -o tests/fixtures/arm32_stage8_instructions.o
stage8: build/libvn135_recovered.so build/test-nonce-verify build/vn135-verify-header
	./build/test-nonce-verify
	$(PYTHON) tests/test_stage8_interpreter.py
	$(PYTHON) tests/test_stage8_differential.py hash
	$(PYTHON) tests/test_stage8_differential.py target
	$(PYTHON) tests/test_stage8_differential.py prefilter
	$(PYTHON) tests/test_stage8_differential.py job
	$(PYTHON) tests/test_stage8_differential.py registry
	$(PYTHON) tests/test_verify_header_cli.py
	$(PYTHON) tools/check_stage8_evidence.py
test: stage8
sanitize: sanitize-stage8
sanitize-stage8:
	mkdir -p build
	$(CC) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer $(SOURCES) tests/test_nonce_verify.c -o build/test-nonce-verify-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-nonce-verify-sanitized
stage8-clang: build/libvn135_recovered-clang.so
	$(CLANG) $(CPPFLAGS) $(CFLAGS) $(STRICT) $(SOURCES) tests/test_nonce_verify.c -o build/test-nonce-verify-clang
	./build/test-nonce-verify-clang
	$(PYTHON) tests/test_stage8_differential.py hash --library ./build/libvn135_recovered-clang.so --tag clang
	$(PYTHON) tests/test_stage8_differential.py target --library ./build/libvn135_recovered-clang.so --tag clang
	$(PYTHON) tests/test_stage8_differential.py prefilter --library ./build/libvn135_recovered-clang.so --tag clang
	$(PYTHON) tests/test_stage8_differential.py job --library ./build/libvn135_recovered-clang.so --tag clang
	$(PYTHON) tests/test_stage8_differential.py registry --library ./build/libvn135_recovered-clang.so --tag clang
	$(CLANG) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer $(SOURCES) tests/test_nonce_verify.c -o build/test-nonce-verify-clang-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-nonce-verify-clang-sanitized
evidence-check: evidence-stage8
.PHONY: evidence-stage8
evidence-stage8:
	$(PYTHON) tools/check_stage8_evidence.py

# Stage 9: saved-template/coinbase/Merkle header prefix, explicit offline binding.
.PHONY: stage9 stage9-clang sanitize-stage9 fixtures-stage9 evidence-stage9
build/test-work-rebuild: $(SOURCES) tests/test_work_rebuild.c tests/fixtures/genesis_work.h $(HEADERS)
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(STRICT) $(SOURCES) tests/test_work_rebuild.c -o $@
fixtures-stage9:
	$(CLANG) --target=armv7-none-eabihf -marm -march=armv7-a -mfpu=vfpv3-d16 -mfloat-abi=hard -c tests/arm32_stage9_instructions.S -o tests/fixtures/arm32_stage9_instructions.o
stage9: build/libvn135_recovered.so build/test-work-rebuild
	./build/test-work-rebuild
	$(PYTHON) tests/test_stage9_interpreter.py
	$(PYTHON) tests/test_stage9_differential.py sha
	$(PYTHON) tests/test_stage9_differential.py prefix
	$(PYTHON) tests/test_stage9_differential.py candidate
	$(PYTHON) tools/generate_genesis_fixture.py
sanitize-stage9:
	mkdir -p build
	$(CC) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer $(SOURCES) tests/test_work_rebuild.c -o build/test-work-rebuild-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-work-rebuild-sanitized
stage9-clang: build/libvn135_recovered-clang.so
	$(CLANG) $(CPPFLAGS) $(CFLAGS) $(STRICT) $(SOURCES) tests/test_work_rebuild.c -o build/test-work-rebuild-clang
	./build/test-work-rebuild-clang
	VN135_TEST_LIBRARY=./build/libvn135_recovered-clang.so $(PYTHON) tests/test_stage9_differential.py sha
	VN135_TEST_LIBRARY=./build/libvn135_recovered-clang.so $(PYTHON) tests/test_stage9_differential.py prefix
	VN135_TEST_LIBRARY=./build/libvn135_recovered-clang.so $(PYTHON) tests/test_stage9_differential.py candidate
	$(CLANG) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer $(SOURCES) tests/test_work_rebuild.c -o build/test-work-rebuild-clang-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-work-rebuild-clang-sanitized
test: stage9
sanitize: sanitize-stage9
build/vn135-rebuild-genesis: $(SOURCES) examples/rebuild_genesis.c tests/fixtures/genesis_work.h $(HEADERS)
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(STRICT) $(SOURCES) examples/rebuild_genesis.c -o $@
stage9: build/vn135-rebuild-genesis
evidence-stage9:
	$(PYTHON) tools/check_stage9_evidence.py
	$(PYTHON) tools/generate_genesis_fixture.py
evidence-check: evidence-stage9
stage9: evidence-stage9

# Stage10: original difficulty arithmetic, work math and a new offline adapter.
.PHONY: stage10 stage10-clang sanitize-stage10 evidence-stage10 fixtures-stage10
