	$(CC) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer $(SOURCES) tests/test_work_difficulty.c -o build/test-work-difficulty-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-work-difficulty-sanitized
stage10-clang: build/libvn135_recovered-clang.so
	$(CLANG) $(CPPFLAGS) $(CFLAGS) $(STRICT) $(SOURCES) tests/test_work_difficulty.c -o build/test-work-difficulty-clang
	./build/test-work-difficulty-clang
