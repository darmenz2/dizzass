	VN135_TEST_LIBRARY=./build/libvn135_recovered-clang.so $(PYTHON) tests/test_stage11_differential.py cleanup
	VN135_TEST_LIBRARY=./build/libvn135_recovered-clang.so $(PYTHON) tests/test_stage11_differential.py fields
	$(CLANG) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer $(SOURCES) tests/test_work_storage.c -o build/test-work-storage-clang-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-work-storage-clang-sanitized
evidence-stage11:
	$(PYTHON) tools/check_stage11_evidence.py
test: stage11
sanitize: sanitize-stage11
evidence-check: evidence-stage11

# Stage12: checked time-roll clone and original-equivalent fixed hex transforms.
.PHONY: stage12 stage12-clang sanitize-stage12 evidence-stage12
build/test-work-time: $(SOURCES) tests/test_work_time.c tests/fixtures/genesis_work.h tests/fixtures/time_roll_vectors.h $(HEADERS)
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(STRICT) $(SOURCES) tests/test_work_time.c -o $@
stage12: build/libvn135_recovered.so build/test-work-time
	./build/test-work-time
	$(PYTHON) tests/test_stage12_differential.py codec
	$(PYTHON) tests/test_stage12_differential.py clone
	$(PYTHON) tests/test_stage12_differential.py composition
sanitize-stage12:
	mkdir -p build
	$(CC) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer $(SOURCES) tests/test_work_time.c -o build/test-work-time-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-work-time-sanitized
stage12-clang: build/libvn135_recovered-clang.so
	$(CLANG) $(CPPFLAGS) $(CFLAGS) $(STRICT) $(SOURCES) tests/test_work_time.c -o build/test-work-time-clang
	./build/test-work-time-clang
	VN135_TEST_LIBRARY=./build/libvn135_recovered-clang.so $(PYTHON) tests/test_stage12_differential.py codec
	VN135_TEST_LIBRARY=./build/libvn135_recovered-clang.so $(PYTHON) tests/test_stage12_differential.py clone
	VN135_TEST_LIBRARY=./build/libvn135_recovered-clang.so $(PYTHON) tests/test_stage12_differential.py composition
	$(CLANG) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer $(SOURCES) tests/test_work_time.c -o build/test-work-time-clang-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-work-time-clang-sanitized
evidence-stage12:
	$(PYTHON) tools/check_stage12_evidence.py
	$(PYTHON) tools/generate_time_fixture.py
test: stage12
sanitize: sanitize-stage12
evidence-check: evidence-stage12

# Stage13: original FIFO and nonce queue wrappers, explicit opaque-tail bridge.
STAGE13_SOURCES = reconstruction/support/record_fifo.c reconstruction/support/nonce_fifo.c reconstruction/support/nonce_record_bridge.c
.PHONY: stage13 stage13-clang sanitize-stage13 evidence-stage13 stage13-threaded
build/test-nonce-fifo: $(SOURCES) tests/test_nonce_fifo.c tests/fixtures/genesis_work.h $(HEADERS)
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(STRICT) $(SOURCES) tests/test_nonce_fifo.c -o $@
build/test-nonce-fifo-threads: $(STAGE13_SOURCES) tests/test_nonce_fifo_threads.c $(HEADERS)
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(STRICT) $(STAGE13_SOURCES) tests/test_nonce_fifo_threads.c -pthread -o $@
stage13: build/libvn135_recovered.so build/test-nonce-fifo
	./build/test-nonce-fifo
	$(PYTHON) tests/test_stage13_differential.py all
stage13-threaded: build/test-nonce-fifo-threads
	./build/test-nonce-fifo-threads
sanitize-stage13:
	mkdir -p build
	$(CC) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer $(SOURCES) tests/test_nonce_fifo.c -o build/test-nonce-fifo-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-nonce-fifo-sanitized
	$(CC) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer $(STAGE13_SOURCES) tests/test_nonce_fifo_threads.c -pthread -o build/test-nonce-fifo-threads-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-nonce-fifo-threads-sanitized
stage13-clang: build/libvn135_recovered-clang.so
	$(CLANG) $(CPPFLAGS) $(CFLAGS) $(STRICT) $(SOURCES) tests/test_nonce_fifo.c -o build/test-nonce-fifo-clang
	./build/test-nonce-fifo-clang
	VN135_TEST_LIBRARY=./build/libvn135_recovered-clang.so $(PYTHON) tests/test_stage13_differential.py all
	$(CLANG) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer $(SOURCES) tests/test_nonce_fifo.c -o build/test-nonce-fifo-clang-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-nonce-fifo-clang-sanitized
	$(CLANG) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer $(STAGE13_SOURCES) tests/test_nonce_fifo_threads.c -pthread -o build/test-nonce-fifo-threads-clang-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-nonce-fifo-threads-clang-sanitized
	$(CLANG) $(CPPFLAGS) $(CFLAGS) $(STRICT) $(STAGE13_SOURCES) tests/test_nonce_fifo_threads.c -pthread -o build/test-nonce-fifo-threads-clang
	./build/test-nonce-fifo-threads-clang
evidence-stage13:
	$(PYTHON) tools/check_stage13_evidence.py
test: stage13
sanitize: sanitize-stage13
evidence-check: evidence-stage13

# Stage14 coherent-snapshot predicates; not original registry/synchronization.
build/test-work-freshness: $(SOURCES) $(HEADERS) tests/test_work_freshness.c
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(STRICT) $(SOURCES) tests/test_work_freshness.c -o $@
.PHONY: stage14 stage14-clang sanitize-stage14
stage14: build/libvn135_recovered.so build/test-work-freshness
	./build/test-work-freshness
	$(PYTHON) tests/test_stage14_interpreter.py
	$(PYTHON) tests/test_stage14_differential.py
stage14-clang: build/libvn135_recovered-clang.so
	VN135_TEST_LIBRARY=build/libvn135_recovered-clang.so $(PYTHON) tests/test_stage14_differential.py
	$(CLANG) $(CPPFLAGS) $(CFLAGS) $(STRICT) $(SOURCES) tests/test_work_freshness.c -o build/test-work-freshness-clang
	./build/test-work-freshness-clang
sanitize-stage14:
	mkdir -p build
	$(CC) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer $(SOURCES) tests/test_work_freshness.c -o build/test-work-freshness-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-work-freshness-sanitized
	$(CLANG) $(CPPFLAGS) -O1 -g $(STRICT) -fsanitize=address,undefined -fno-omit-frame-pointer $(SOURCES) tests/test_work_freshness.c -o build/test-work-freshness-clang-sanitized
	ASAN_OPTIONS=detect_leaks=1 ./build/test-work-freshness-clang-sanitized
